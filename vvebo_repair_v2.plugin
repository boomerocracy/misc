#!name=VVebo 时间线修复 V2（缓存防卡版）
#!desc=修复 VVebo 3.3.31 用户主页时间线；异常时使用按用户缓存，分页失败时立即结束。
#!author=Local Fix
#!system=iOS,iPadOS

[Rule]
DOMAIN,api.weibo.cn,DIRECT
DOMAIN,m.weibo.cn,DIRECT
DOMAIN,passport.weibo.cn,DIRECT
DOMAIN-SUFFIX,weibo.com,DIRECT
DOMAIN-SUFFIX,weibo.cn,DIRECT
DOMAIN-SUFFIX,sinaimg.cn,DIRECT

[Script]
http-request ^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\? script-path=https://raw.githubusercontent.com/boomerocracy/misc/refs/heads/main/vvebo_repair_v2.js,timeout=10,tag=VVebo V2 保存账号 UID,enable=true
http-request ^https:\/\/api\.weibo\.cn\/2\/users\/show\? script-path=https://raw.githubusercontent.com/boomerocracy/misc/refs/heads/main/vvebo_repair_v2.js,timeout=10,tag=VVebo V2 保存主页 UID,enable=true
http-request ^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\? script-path=https://raw.githubusercontent.com/boomerocracy/misc/refs/heads/main/vvebo_repair_v2.js,timeout=10,tag=VVebo V2 改写用户时间线,enable=true
http-response ^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\? script-path=https://raw.githubusercontent.com/boomerocracy/misc/refs/heads/main/vvebo_repair_v2.js,requires-body=true,timeout=10,tag=VVebo V2 转换并缓存时间线,enable=true
http-response ^https:\/\/api\.weibo\.cn\/2\/cardlist\?.*selffans script-path=https://raw.githubusercontent.com/boomerocracy/misc/refs/heads/main/vvebo_repair_v2.js,requires-body=true,timeout=10,tag=VVebo V2 修复粉丝列表,enable=true

[Mitm]
hostname = api.weibo.cn
